# ╔═══════════════════════════════════════════════════════╗
# ║   Telegram Groups Moderator Bot - Environment File   ║
# ╚═══════════════════════════════════════════════════════╝
# 
# YANGI .env FAYL YARATING VA QUYIDAGI MA'LUMOTLARNI YOZING:
# shuningdek .env.dist faylini .env ga nomini o'zgartiring
#
# Qanday oling:
# - BOT_TOKEN: @BotFather ga /newbot yuboring
# - ADMINS: @userinfobot ga yozing
#

# ╔═══════════════════════════════════════════════════════╗
# ║   Telegram Bot Sozlamalari (REQUIRED)                ║
# ╚═══════════════════════════════════════════════════════╝

# Bot token(@BotFather dan oling)
# Format: 1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghij
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Adminlarning Telegram ID'lari (vergul bilan ajratilgan)
# Format: 123456789,987654321,111111111
ADMINS=YOUR_ADMIN_ID_HERE

# Xostning IP manzili (webhook uchun, polling uchun shart emas)
ip=localhost

# ╔═══════════════════════════════════════════════════════╗
# ║   Database Sozlamalari (OPTIONAL)                    ║
# ╚═══════════════════════════════════════════════════════╝

# SQLite database fayli joylashuvi
# Default: ./data/bot.db
# DATABASE_URL=./data/bot.db

# ╔═══════════════════════════════════════════════════════╗
# ║   Logging Sozlamalari (OPTIONAL)                     ║
# ╚═══════════════════════════════════════════════════════╝

# Log fayllari direktoriyasi
# Default: ./logs
# LOGS_DIR=./logs

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Default: INFO
# LOG_LEVEL=INFO

# ╔═══════════════════════════════════════════════════════╗
# ║   Bot Xususiyatlari Sozlamalari (OPTIONAL)           ║
# ╚═══════════════════════════════════════════════════════╝

# Default ogohlantirshlar soni (warn count)
# Default: 3
# DEFAULT_WARNS=3

# Default flood limit (xabarlar soni)
# Default: 5
# DEFAULT_FLOOD_LIMIT=5

# Default flood vaqti (soniyalarda)
# Default: 10
# DEFAULT_FLOOD_TIME=10

